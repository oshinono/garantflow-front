# Базовый URL API. Пусто — тот же origin (в dev работает прокси /api → VITE_PROXY_TARGET).
VITE_API_BASE_URL=
# Куда dev-сервер проксирует /api.
VITE_PROXY_TARGET=http://localhost:8000
# Включает слой заглушек для функций без API (раздел 8.3 ТЗ). false — функции скрыты с пометкой «Скоро».
VITE_USE_STUBS=true
# Поднимает в браузере мок-бэкенд на MSW по предварительному контракту openapi/provisional.yaml.
VITE_API_MOCK=false
